# Firebase (artwork uploads)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: override the send endpoint (defaults to /api/send-quote on same origin).
# Useful if the calc is iframed from a different origin than the Vercel deployment.
# VITE_SEND_QUOTE_ENDPOINT=https://local-threads-calculator.vercel.app/api/send-quote

# --- SERVER-ONLY (set in Vercel Project Settings, NOT shipped to the browser) ---
# Gmail API OAuth credentials for the olivebranchgrowth@gmail.com sender.
# Copy these from the obg-onboarding-api Vercel project.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional CORS allowlist for the /api/send-quote endpoint (comma-separated).
# ALLOWED_ORIGIN=https://localthreadsohio.com,https://www.localthreadsohio.com,https://local-threads-calculator.vercel.app

# Analytics (build-time). GA4 measurement id + Microsoft Clarity project id.
VITE_GA_MEASUREMENT_ID=
VITE_CLARITY_ID=

# Shared OBG garment catalog (read-only). Powers the "browse all styles" picker.
# Without these the calculator still runs on the curated styles in src/garments/.
# The publishable key is the client-safe one and ships in the bundle; grab it
# from the shared key store rather than committing it here.
VITE_SUPABASE_URL=https://ydwzfnawueliuvywedla.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
